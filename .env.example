# ── easySales — Variables de entorno ──────────────────────────────────
# Copiá este archivo como .env y completá los valores.
# NUNCA subas el .env real a git ni lo compartas.

# Contraseña para acceder a la app (la que ingresás en el login)
APP_PASSWORD=cambia_esta_contrasena_por_una_segura

# Credenciales de Supabase (Settings → API)
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGci...tu_anon_key_aqui

# String aleatorio para firmar tokens de sesión.
# Generá uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=genera_un_string_aleatorio_largo_aqui

# Puerto (opcional, por defecto 3000)
# PORT=3000
